{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad.engineering/schemas/verification-evidence.schema.json",
  "title": "Triad verification evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "feature_id", "attempt", "assignment_id", "assignment_sha256", "trigger", "baseline", "gates", "required_gates_passed", "status", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": ["integer", "null"], "minimum": 1 },
    "assignment_id": { "type": ["string", "null"] },
    "assignment_sha256": { "type": ["string", "null"] },
    "trigger": { "type": "object", "required": ["event", "agent_id", "agent_type"], "properties": { "event": { "type": "string" }, "agent_id": { "type": ["string", "null"] }, "agent_type": { "type": ["string", "null"] } } },
    "baseline": { "type": "object", "required": ["prd_sha256", "card_sha256", "git_head", "candidate_fingerprint"], "properties": { "prd_sha256": { "type": ["string", "null"] }, "card_sha256": { "type": ["string", "null"] }, "quality_baseline_fingerprint": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }, "git_head": { "type": ["string", "null"] }, "candidate_fingerprint": { "type": ["string", "null"] }, "branch": { "type": ["string", "null"] } } },
    "candidate_manifest": {
      "type": ["object", "null"],
      "required": ["base_commit", "git_head", "changes", "ignored_paths", "files"],
      "properties": {
        "base_commit": { "type": ["string", "null"] },
        "git_head": { "type": ["string", "null"] },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string" },
              "path": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] },
              "destination": { "type": ["string", "null"] }
            }
          }
        },
        "ignored_paths": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "assignment_packet": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "artifact_manifest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "root", "schema_version", "run_id", "assignment_id", "feature_id", "attempt", "candidate_fingerprint", "status", "artifacts"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "root": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "assignment_id": { "type": "string", "minLength": 1 },
        "feature_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "candidate_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "status": { "const": "current" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "root", "media_type", "sha256", "size_bytes", "producer_gate_id", "run_id", "assignment_id", "candidate_fingerprint", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "minLength": 1 },
              "media_type": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "producer_gate_id": { "type": "string", "minLength": 1 },
              "run_id": { "type": "string", "minLength": 1 },
              "assignment_id": { "type": "string", "minLength": 1 },
              "candidate_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "status": { "const": "current" }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "configured": { "type": "boolean" },
        "status": { "enum": ["not_configured", "pass", "fail"] },
        "baseline": { "type": ["object", "null"] },
        "changed_paths": { "type": "array" },
        "offending_paths": { "type": "array" }
      }
    },
    "gate_selection": {
      "type": "object",
      "required": ["mode", "card_required_gate_ids", "baseline_required_gate_ids", "effective_gate_ids", "effective_required_gate_ids", "missing_gate_ids", "invalid_gate_ids"],
      "properties": {
        "mode": { "enum": ["legacy", "selected"] },
        "card_required_gate_ids": { "type": "array", "items": { "type": "string" } },
        "baseline_required_gate_ids": { "type": "array", "items": { "type": "string" } },
        "effective_gate_ids": { "type": "array", "items": { "type": "string" } },
        "effective_required_gate_ids": { "type": "array", "items": { "type": "string" } },
        "missing_gate_ids": { "type": "array", "items": { "type": "string" } },
        "invalid_gate_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason"],
            "properties": { "id": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "executor": { "type": "string" },
          "status": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "exit_code": { "type": ["integer", "null"] },
          "duration_ms": { "type": ["integer", "null"] },
          "stdout_ref": { "type": ["string", "null"] },
          "stderr_ref": { "type": ["string", "null"] },
          "output_truncated": { "type": "boolean" },
          "provenance": {
            "type": ["object", "null"],
            "properties": {
              "declared": { "type": "object" },
              "provenance_status": { "type": "string" },
              "resolved_executable": { "type": ["string", "null"] },
              "sha256": { "type": ["string", "null"] },
              "version": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "required_gates_passed": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "invalid_context", "infrastructure_error", "invalidated"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
