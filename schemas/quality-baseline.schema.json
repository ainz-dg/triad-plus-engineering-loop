{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad.engineering/schemas/quality-baseline.schema.json",
  "title": "Triad immutable Quality Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "sources", "criteria", "fingerprint"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "requirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["product_quality", "delivery_closure"] },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
