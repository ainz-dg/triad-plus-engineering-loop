{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad.engineering/schemas/evidence-manifest.schema.json",
  "title": "Triad generic repository evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "assignment_id",
    "feature_id",
    "attempt",
    "candidate_fingerprint",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "candidate_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "status": { "const": "current" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "sha256",
          "size_bytes",
          "producer_gate_id",
          "run_id",
          "assignment_id",
          "candidate_fingerprint",
          "status"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "media_type": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "producer_gate_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "assignment_id": { "type": "string", "minLength": 1 },
          "candidate_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "status": { "const": "current" }
        }
      }
    }
  }
}
